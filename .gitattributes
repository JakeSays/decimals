# Line endings are set here, so they do not depend on each contributor's core.autocrlf.

# All files use LF, in the repository and in the working tree, on every platform. "auto"
# still lets git detect binary files and leave them alone.
* text=auto eol=lf

# Except the test data, which is stored exactly as published. 89 of the Cowlishaw corpus
# files use CRLF. Turning off conversion stores each file as it is on disk. The files are
# still treated as text by diff and merge.
TestData/** -text
