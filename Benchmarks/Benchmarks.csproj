<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Decimals.Benchmarks</RootNamespace>
    <!-- No AssemblyName override here, unlike DecTest: BenchmarkDotNet locates the project
         file by searching for one named after the assembly, and builds the generated
         boilerplate against it. A kebab-case binary name would leave it unable to find
         this project at all. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- BenchmarkDotNet refuses to measure a debug build, and says so loudly. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Decimal32\Decimal32.csproj" />
    <ProjectReference Include="..\Decimal64\Decimal64.csproj" />
    <ProjectReference Include="..\Decimal128\Decimal128.csproj" />
  </ItemGroup>

</Project>
